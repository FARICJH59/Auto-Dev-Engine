# Auto-Dev-Engine Root Environment Variables
# This file shows all required secrets for GitHub Actions

# Google Cloud Platform Secrets (for Cloud Run deployment)
GCP_PROJECT_ID=your-gcp-project-id
GCP_SA_KEY={"type":"service_account",...}  # Full JSON key
GCP_REGION=us-central1

# Vercel Secrets (for frontend deployment)
VERCEL_TOKEN=your-vercel-deployment-token
VERCEL_ORG_ID=team_xxxxx
VERCEL_PROJECT_ID=prj_xxxxx

# Optional: API Keys
GEMINI_API_KEY=your-gemini-api-key

# Optional: Cloud Run URL (set after first deployment)
CLOUD_RUN_URL=https://ade-orchestrator-xxxxx.run.app

# Note: Add these to GitHub Secrets at:
# https://github.com/YOUR_USERNAME/YOUR_REPO/settings/secrets/actions
